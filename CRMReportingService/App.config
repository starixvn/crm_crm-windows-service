    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging"/>
    <!--End Fanex Setting-->
    <section name="couchbase" type="Couchbase.Configuration.CouchbaseClientSection, Couchbase"/>
  </configSections>

  <!--Fanex Setting-->
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data" resourcePath="AppFiles/Configurations/StoreProcedure.xml" enableWatching="1"/>
    </providers>
  </Fanex.Data.DbSettingProvider>
  <Fanex.Logging msmqPath="FormatName:DIRECT=TCP:10.18.200.201\private$\entlib" defaultCategory="BeArt"/>
  <!--End Fanex Setting-->
  <couchbase>
