    <!--End Mail-->
    <!--Store Procedure-->
    <section name="StoreProcedure" type="NexCel.CRM.CRMReportingService.Core.Infrastructure.Configurations.StoreProcedureSection, CRMReportingService, Version=1.0.0.0, Culture=neutral"/>
