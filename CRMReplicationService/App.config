<?xml version="1.0"?>
<configuration>
  <configSections>
    <!--Mail-->
    <section name="MailSection" type="NexCel.CRM.CRMReportingService.Core.Infrastructure.Configurations.MailSection, CRMReportingService, Version=1.0.0.0, Culture=neutral"/>
    <!--End Mail-->
    <!--Fanex setting-->
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
    <!--Enterprise Library Distributor Service-->
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <!--End Fanex Setting-->
    <section name="couchbase" type="Couchbase.Configuration.CouchbaseClientSection, Couchbase" />
  </configSections>
  <!--Fanex Setting-->
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data" resourcePath="AppFiles\Configurations\StoreProcedure.xml" enableWatching="1" />
    </providers>
  </Fanex.Data.DbSettingProvider>
  <Fanex.Logging msmqPath="FormatName:DIRECT=TCP:10.18.200.202\private$\entlib" defaultCategory="BeArt" />
  <!--<Fanex.Logging msmqPath="FormatName:DIRECT=TCP:10.18.200.201\private$\entlib" defaultCategory="BeArt"/>-->
  <!--End Fanex Setting-->
  <couchbase>
    <servers bucket="Accounting" bucketPassword="">
      <add uri="http://10.18.200.202:8091/pools/default" />
      <add uri="http://10.18.200.207:8091/pools/default" />
      <add uri="http://10.18.200.210:8091/pools/default" />
    </servers>
  </couchbase>
  <appSettings>
    <add key="connectionString" value="mongodb://crmadmin:123456@10.18.200.202:27017/?safe=true" />
    <add key="dbname" value="CRM" />
    <add key="tbCustomers" value="crmCustomer" />
    <add key="CustomerTimer" value="60000" />
    <add key="CheckMemoryUsageTimer" value="60000" />
    <add key="MemoryUsageLimit" value="100000" />
    <add key="ClientSettingsProvider.ServiceUri" value="" />
  </appSettings>
  <connectionStrings>
    <!--<add name="CRM" connectionString="packet size=4096; Data Source=10.18.200.214;Asynchronous Processing=true;Initial Catalog=bodb_CRM;integrated security=false; user id=bodbAdminNet; password=i9hNnaZltx04XF6oTNOKTnvvtLC/zfxr=" providerName="System.Data.SqlClient"/>-->
    <add name="CRM" connectionString="packet size=4096; Data Source=10.18.200.214;Asynchronous Processing=true;Initial Catalog=bodb_CRM;integrated security=false; user id=bodbAdminNet; password=i9hNnaZltx04XF6oTNOKTnvvtLC/zfxr=" providerName="System.Data.SqlClient" />
  </connectionStrings>

  <MailSection configSource="AppFiles\Configurations\MailSection.config"></MailSection>
  
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
  </startup>
  <system.web>
    <membership defaultProvider="ClientAuthenticationMembershipProvider">
      <providers>
        <add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" />
      </providers>
    </membership>
    <roleManager defaultProvider="ClientRoleProvider" enabled="true">
      <providers>
        <add name="ClientRoleProvider" type="System.Web.ClientServices.Providers.ClientRoleProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" cacheTimeout="86400" />
      </providers>
    </roleManager>
  </system.web>
</configuration>